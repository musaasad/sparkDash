      "modelRef": { "modelId": "deepseek-v41-flash", "weightId": "default" },
      "name": "vLLM TP2 (dgx-1 + dgx-2)",
      "engine": { "runtime": "vllm", "quantization": "exl3", "apiProtocol": "openai" },
      "serving": { "contextLength": 600000, "maxParallel": 2, "flags": [] },
      "launch": {
        "mechanism": "external",
        "executable": "vllm",
        "args": [
          "serve",
          "/model",
          "--served-model-name",
          "DeepSeek-V4.1-Flash-UNCENSORED-EXL3",
          "--tensor-parallel-size",
          "2",
          "--nnodes",
          "2"
        ],
        "command": "vllm serve /model --served-model-name DeepSeek-V4.1-Flash-UNCENSORED-EXL3 --tensor-parallel-size 2 --nnodes 2 (containerized)",
        "workdir": "/model",
        "env": []
      },
      "endpoint": { "scheme": "http", "hostTemplate": "{nodeIp}", "port": 8888, "path": "/v1" },
      "topology": {
