    {
      "id": "qwen38-tabbyapi-dgx3",
      "schemaVersion": 2,
      "modelRef": { "modelId": "qwen38-flash-next", "weightId": "default" },
      "name": "TabbyAPI EXL3 (dgx-3)",
      "engine": { "runtime": "tabbyapi-exl3", "quantization": "exl3", "apiProtocol": "openai" },
      "serving": {
        "contextLength": 262144,
        "flags": [
          { "name": "cpuAffinity", "value": "5-9,15-19" },
          { "name": "serveWebUi", "value": "true" }
        ]
      },
      "launch": {
        "mechanism": "external",
        "executable": "taskset",
        "args": ["-c", "5-9,15-19", "python", "main.py"],
        "command": "taskset -c 5-9,15-19 python main.py",
        "workdir": "/home/musaasad/tabbyAPI",
        "env": [
          { "name": "EXL3_INT8_GEMV", "value": "0" },
          { "name": "EXL3_MOE_COOP_WIDE", "value": "1" },
          { "name": "EXL3_GR_INT8", "value": "1" },
          { "name": "EXL3_MTP_HEAD_N", "value": "65536" },
          { "name": "EXL3_NGRAM_STREAM", "value": "0" },
          { "name": "TORCH_CUDA_ARCH_LIST", "value": "12.1" }
        ]
      },
      "endpoint": { "scheme": "http", "hostTemplate": "{nodeIp}", "port": 8889, "path": "/v1" },
      "topology": {
        "mode": "single",
        "parallelism": 1,
        "minNodes": 1,
        "maxNodes": 1,
        "nodeConstraints": {}
      },
      "healthProbe": { "kind": "http", "path": "/v1/models", "expectUp": [200, 401, 403] },
      "discovery": { "strategy": "process" },
      "logSource": { "kind": "file", "path": "/home/musaasad/tabbyAPI/logs" },
      "tags": ["tabbyapi", "exl3", "single"],
      "metadata": { "managedBy": "external", "venv": "/home/musaasad/exllamav3/.venv" },
      "lifecycleState": "proven",
      "provenance": {
        "validatedAt": 1790040631830,
        "provenAt": 1790040631831,
        "note": "Known-good single-node deployment, started outside SparkDash."
      },
      "notes": "Known-good single-node deployment. Started outside SparkDash — observe-only.",
      "createdAt": 1790040631824,
      "updatedAt": 1790040631824
    },
    {
      "id": "v41-tp2-vllm-dgx12",
