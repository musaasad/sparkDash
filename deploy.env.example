# sparkDash production env — COPY to ~/sparkDash-production-config/deploy.env
# (chmod 600). NEVER commit the real file; it holds the LAN auth token.
# Consumed by scripts/deploy-production.sh (--env-file) and docker compose.

# Bearer token for authenticated LAN access. Generate: openssl rand -hex 32
SPARKDASH_TOKEN=

# Persistent config/secrets dir OUTSIDE the git checkout (holds sparks.json,
# sparks-secrets.json, .secrets-key, settings.json, gpu-memory.sh).
SPARKDASH_CONFIG_DIR=/home/musaasad/sparkDash-production-config

# Monitoring SSH private key (host path), mounted read-only into the container.
SPARKDASH_SSH_KEY=/home/musaasad/.ssh/id_ed25519_nvsync_cluster_assistant

# Optional overrides (defaults shown):
# SPARKDASH_BRANCH=feature/ai-lab-control-plane
# SPARKDASH_IMAGE=sparkdash-production:latest
# SPARKDASH_CONTAINER=sparkDash
# PORT=5555
# SPARKDASH_CANARY_PORT=5557
# BIND_HOST=0.0.0.0
# SPARKDASH_ALLOW_OPEN_REMOTE=0
# VITE_HISTORY_HOURS=8